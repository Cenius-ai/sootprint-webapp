# Sootprint reads only two environment variables, and both have safe defaults.
# Copy this file to .env only if you want to override something: `cp .env.example .env`.
# Neither value is required - Sootprint runs with no configuration at all.

# Directory that holds the sweep log (sweeps.json).
# Leave empty to use the default: ~/.sootprint
SOOTPRINT_HOME=

# Set to any non-empty value (for example 1) to suppress ANSI colour.
# Empty means "colour is used only when stdout is a real terminal".
NO_COLOR=
